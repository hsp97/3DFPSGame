{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "03e1113e9cf94b548a8e0ff5d317c6e3",
    "m_Title": "4. Erosion",
    "m_Content": "erosion = saturate(Erosion + Custom1.x + UV.x × AgeErosion)\nvisible = saturate((noise − erosion × (1 + Softness)) / Softness + 1)\nalpha = mask × visible",
    "m_TextSize": 0,
    "m_Theme": 0,
