{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "e49c3ba64fcb4dbab89d715d0410f52d",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Value Noise",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 2600,
            "y": 750,
            "width": 208,
            "height": 125
        }
    },
    "m_Slots": [
        {
            "m_Id": "e19e9876629f4aeb83ef65f57a38743e"
        },
        {
            "m_Id": "b0e0d728f065448e8eb99220ebd0cf33"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SlashValueNoise",
    "m_FunctionSource": "",
    "m_FunctionBody": "float2 c = floor(P);\nfloat2 f = frac(P);\nf = f * f * (3.0 - 2.0 * f);\nfloat a = frac(sin(dot(c, float2(127.1, 311.7))) * 43758.5453);\nfloat b = frac(sin(dot(c + float2(1, 0), float2(127.1, 311.7))) * 43758.5453);\nfloat d = frac(sin(dot(c + float2(0, 1), float2(127.1, 311.7))) * 43758.5453);\nfloat e = frac(sin(dot(c + float2(1, 1), float2(127.1, 311.7))) * 43758.5453);\nOut = lerp(lerp(a, b, f.x), lerp(d, e, f.x), f.y);",
    "m_FunctionSourceUsePragmas": true
}

